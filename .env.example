# Copy to .env and change every value before running.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.

# ---- JWT ----
# HS256 signing key shared by auth-service (signs) and gateway (verifies).
# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# ---- Postgres: auth ----
AUTH_DB_NAME=pesowise_auth
AUTH_DB_USER=pesowise
AUTH_DB_PASSWORD=change-me
AUTH_DB_PORT=5433

# ---- Postgres: ledger ----
LEDGER_DB_NAME=pesowise_ledger
LEDGER_DB_USER=pesowise
LEDGER_DB_PASSWORD=change-me
LEDGER_DB_PORT=5434

# ---- Postgres: planning ----
PLANNING_DB_NAME=pesowise_planning
PLANNING_DB_USER=pesowise
PLANNING_DB_PASSWORD=change-me
PLANNING_DB_PORT=5435

# ---- Postgres: admin ----
ADMIN_DB_NAME=pesowise_admin
ADMIN_DB_USER=pesowise
ADMIN_DB_PASSWORD=change-me
ADMIN_DB_PORT=5436

# ---- Service ports (host side) ----
GATEWAY_PORT=8080
AUTH_PORT=8081
LEDGER_PORT=8082
PLANNING_PORT=8083
ADMIN_PORT=8084
FRONTEND_PORT=3000

# ---- Frontend ----
# Base URL the browser uses to reach the gateway.
VITE_API_URL=http://localhost:8080

# ---- Administrators ----
# Comma-separated addresses granted the ADMIN role. Promoted at startup if the account already
# exists, or on registration if it does not — so the order of deploying and signing up does not
# matter. Removing an address here does NOT demote anyone; demotion is an explicit admin action.
PESOWISE_ADMIN_EMAILS=

# ---- Email ----
# Off by default. With delivery disabled, verification and password-reset links are written to
# the auth-service log instead of being sent, and new registrations verify themselves — so the
# whole stack runs with no SMTP account. Set this to true anywhere anyone else can reach the app,
# or nobody but you can ever confirm an address.
MAIL_ENABLED=false

# Whether a new account must confirm its address before signing in. Blank means "follow
# MAIL_ENABLED". Set it to true while MAIL_ENABLED stays false to walk the real confirmation
# flow using links read from `docker logs pesowise-auth-service` — useful for testing the
# journey before an SMTP account exists.
MAIL_REQUIRE_VERIFICATION=

# Brevo's free tier is a reasonable default: 300 emails/day, plain SMTP, and it verifies a single
# sender address rather than requiring a whole domain. Any SMTP provider works.
# Port 587 is blocked outbound on some corporate/ISP networks; Brevo also accepts STARTTLS on
# 2525 for exactly that case. If mail silently times out with "Connection refused", try 2525.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Must be an address the provider has verified, or delivery is rejected.
MAIL_FROM=no-reply@pesowise.app
MAIL_FROM_NAME=PesoWise

# The browser-facing origin that emailed links point at. Not derived from the request: the
# service sits behind a gateway and an nginx proxy, so the inbound Host header is not a
# trustworthy basis for a link that grants account access. Set this to your real domain.
# In production this also becomes the gateway's CORS_ALLOWED_ORIGIN — see docker-compose.prod.yml.
PUBLIC_URL=http://localhost:3000

# ---- Production only (docker-compose.prod.yml) ----
# Bare hostname (no scheme) that Caddy requests a Let's Encrypt certificate for — its DNS record
# must already point at this host before starting the stack, or the ACME challenge fails. Not
# used at all by the dev stack. Free option: a DuckDNS subdomain.
PESOWISE_DOMAIN=pesowise.example.com
